<?xml version="1.0" encoding="utf-8"?>
<!--
  A MaterialButton's disabled state is not just a dimmer version of its normal
  colour — Android blends in the theme's colorSurface, which defaults to white
  unless a theme overrides it. That is where the white showed up: the
  Sensitivity/Reload/Manage buttons turn this pale grey/white while enrolling,
  because they get disabled and nothing told Android what "disabled" should
  look like here. This state list pins both states to the same dark colour.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/button_face" />
    <item android:color="@color/button_face" />
</selector>
