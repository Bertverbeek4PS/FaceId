<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Low-glare palette. Nothing here is a large light-emitting area: the
         screen stays essentially black and only thin strokes and text glow.

         The amber is deliberately desaturated and darkened from the usual
         #FFC400. It still measures about 7:1 against black, which is well past
         the 4.5:1 needed for body text and the 3:1 needed for large text, but
         it emits far less light than full-brightness amber. -->
    <color name="black">#FF000000</color>
    <color name="amber">#FFC9962B</color>
    <color name="amber_dim">#FFA87F26</color>
    <color name="button_face">#FF0C0C0C</color>
    <color name="grey_dim">#FF6E6E6E</color>
    <color name="white">#FFFFFFFF</color>

    <color name="dialog_bg">#FF0A0A0A</color>
    <color name="icon_background">#FF101010</color>
</resources>
