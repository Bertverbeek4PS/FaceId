<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FaceID" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/amber</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/black</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/black</item>
    </style>

    <style name="BigButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/amber</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/amber</item>
        <item name="strokeColor">@color/amber</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
