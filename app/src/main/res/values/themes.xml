<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FaceID" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/amber</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/black</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/black</item>
        <!-- Theme.MaterialComponents (the light variant) defaults these to
             white/near-black. A disabled MaterialButton blends colorSurface
             underneath it, so leaving this unset is what let white leak
             through on the disabled buttons. -->
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/amber_dim</item>
    </style>

    <!-- The main action used to be a solid amber slab. On a screen held close
         to the face that is a lamp. It is now a near-black panel with a thick
         amber edge: same size, same easy target, a fraction of the light. -->
    <style name="BigButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/amber</item>
        <item name="backgroundTint">@color/button_face_selector</item>
        <item name="strokeColor">@color/amber</item>
        <item name="strokeWidth">4dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="rippleColor">@color/amber_dim</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/amber_dim</item>
        <item name="backgroundTint">@color/button_face_selector</item>
        <item name="strokeColor">@color/amber_dim</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/amber_dim</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <!-- Pop-ups default to Android's light theme, which is a white slab in the
         middle of an otherwise black app. This matches them to the main
         screen: black panel, amber text, amber buttons. -->
    <style name="DarkDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/dialog_bg</item>
        <item name="android:windowBackground">@color/dialog_bg</item>
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:textColorPrimary">@color/amber</item>
        <item name="android:textColorSecondary">@color/amber_dim</item>
        <item name="android:textColorAlertDialogListItem">@color/amber</item>
        <item name="android:textColorHint">@color/grey_dim</item>
        <item name="android:buttonBarButtonStyle">@style/DarkDialogButton</item>
    </style>

    <style name="DarkDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/amber</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
