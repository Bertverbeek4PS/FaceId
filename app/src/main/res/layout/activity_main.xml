<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Dims the camera image so the amber text stays readable on top of it. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/amber"
            android:textSize="52sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeMaxTextSize="72sp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/status_loading" />

        <TextView
            android:id="@+id/tvDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:textColor="@color/grey_dim"
            android:textSize="20sp"
            android:importantForAccessibility="no"
            android:text="" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMain"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:text="@string/btn_start" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReload"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="88dp"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_reload" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSensitivity"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="88dp"
                android:layout_marginStart="6dp"
                android:text="@string/btn_sensitivity" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
